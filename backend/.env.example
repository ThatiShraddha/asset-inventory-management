# AssetFlow Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=4000
NODE_ENV=development

# Database — PostgreSQL
# For Docker: postgresql://eims_admin:eims_secure_password_9021@localhost:5432/eims_inventory_db
DATABASE_URL=postgresql://eims_admin:eims_secure_password_9021@localhost:5432/eims_inventory_db

# JWT Secrets — Change these in production!
JWT_SECRET=assetflow-dev-access-secret-change-me-2026
REFRESH_SECRET=assetflow-dev-refresh-secret-change-me-2026

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
